# AWS Region
aws_region = "ap-south-1"

# SSH Key Pair Name
key_name = "ch-key"

# Path to the public key
public_key_path = "ch-key.pub"

# Security Group Name
sg_name = "ch-tf-sg"

# EC2 Instance Type
instance_type = "t3.small"

# EC2 AMI ID
ami_id = "ami-01a00762f46d584a1"

# Root Volume Size (in GB)
volume_size = 20

# Root Volume Type
volume_type = "gp3"

# EC2 Instance Name Tag
instance_name = "TF-CH-EC2"

# GitHub Token for backend
github_token = "ghp_your_token_here"
